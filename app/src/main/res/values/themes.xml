<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; the UI is styled by HaacTheme in Compose. -->
    <style name="Theme.Haac" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/haac_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Shown by the splash screen API until the stored design is read, so the first frame has the right colours. -->
    <style name="Theme.Haac.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/haac_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Haac</item>
    </style>

    <color name="haac_background">#F3F5F0</color>
</resources>
